{
  "name": "sori-korean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "data:generate": "node --import tsx scripts/generate-vocabulary.ts",
    "data:validate": "node --import tsx scripts/validate-vocabulary.ts",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.0"
  }
}
